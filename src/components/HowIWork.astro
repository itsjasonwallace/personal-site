---
import Reveal from "./Reveal.astro";

const cards = [
  {
    tag: "Leadership",
    title: "I run engineering like an operator.",
    body: "Outcomes over output. Every team I run has a one-line goal everyone can recite. I've scaled orgs, grown leaders, and shipped on time, quarter after quarter.",
  },
  {
    tag: "Architecture",
    title: "I design systems that survive change.",
    body: "DDD boundaries, contract-first APIs, event-driven cores. Architectures live for a decade; the bet is on the seams. I'm still in the codebase.",
  },
  {
    tag: "AI",
    title: "AI-native by default.",
    body: "Applied AI and agentic systems in production, with the guardrails, evals, and policy to match. Since 2023, bringing AI into regulated workflows where it has to be trustworthy, not just clever.",
  },
  {
    tag: "Modernization",
    title: "Monolith → cloud-native without the theater.",
    body: "I've led modernizations on Azure, GCP, and Cloud Foundry. Pick the smallest cut that unlocks the business case; ship; compound from there.",
  },
];
---

<section id="how-i-work">
  <Reveal>
    <div class="label">Practice</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      How I work.
    </h2>
  </Reveal>

  <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      cards.map((c, i) => (
        <Reveal delay={i * 70}>
          <article class="card h-full p-6">
            <div class="flex items-center gap-2.5">
              <span class="accent-square" aria-hidden="true" />
              <span class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-ink">
                {c.tag}
              </span>
            </div>
            <h3 class="mt-4 font-display text-[22px] leading-snug text-ink">
              {c.title}
            </h3>
            <p class="mt-3 text-[14.5px] leading-relaxed text-ink-soft">
              {c.body}
            </p>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
