---
import Reveal from "./Reveal.astro";

const chapters = [
  {
    role: "Senior Engineering Manager",
    company: "Charles Schwab",
    dates: "May 2019 — Present",
  },
  {
    role: "Associate Director of Development",
    company: "Galliard Capital Management",
    dates: "Dec 2014 — Apr 2019",
  },
  {
    role: "Solution Architect",
    company: "Wells Fargo",
    dates: "Nov 2009 — Nov 2014",
  },
  {
    role: "Director of Technology · Co-founder",
    company: "Skyline Document Services",
    dates: "Jan 2007 — Dec 2010",
  },
  {
    role: "Lead Software Engineer",
    company: "Lighthouse eDiscovery",
    dates: "2002 — 2006",
  },
];
---

<section id="career">
  <Reveal>
    <div class="label">Career</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      Five chapters.
    </h2>
  </Reveal>

  <Reveal delay={80}>
    <ol
      class="card mt-7 grid grid-cols-[2.5rem_1fr_auto] gap-x-5 divide-y divide-rule sm:grid-cols-[2.5rem_minmax(0,1.4fr)_minmax(0,1fr)_auto]"
    >
      {
        chapters.map((c, i) => (
          <li class="col-span-full grid grid-cols-subgrid items-center px-6 py-5">
            <span class="font-mono text-[12px] text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-display text-[18px] leading-tight text-ink sm:text-[19px]">
              {c.role}
            </span>
            <span class="hidden font-display italic text-[15px] text-ink-soft sm:block">
              {c.company}
            </span>
            <span class="font-mono text-[11.5px] text-muted">{c.dates}</span>
            <span class="col-start-2 col-end-4 font-display italic text-[14px] text-ink-soft sm:hidden">
              {c.company}
            </span>
          </li>
        ))
      }
    </ol>
  </Reveal>
</section>
