---
import Reveal from "./Reveal.astro";

import { chapters, formatDates } from "../data/career";
---

<section id="career">
  <Reveal>
    <div class="label">Career</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      Five chapters.
    </h2>
  </Reveal>

  <Reveal delay={80}>
    <ol
      class="card mt-7 grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 divide-y divide-rule sm:grid-cols-[2.5rem_minmax(0,1.4fr)_minmax(0,1fr)_auto]"
    >
      {
        chapters.map((c, i) => (
          <li class="col-span-full grid grid-cols-subgrid items-start px-6 py-5 sm:items-center">
            <span class="pt-0.5 font-mono text-[12px] text-accent sm:pt-0">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0 sm:col-span-3 sm:grid sm:grid-cols-subgrid sm:items-center">
              <span class="block font-display text-[18px] leading-tight text-ink sm:text-[19px]">
                {c.role}
              </span>
              <span class="mt-1 block font-display italic text-[14px] text-ink-soft sm:mt-0 sm:text-[15px]">
                {c.company}
              </span>
              <span class="mt-2 block font-mono text-[11.5px] text-muted sm:mt-0">
                {formatDates(c)}
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </Reveal>
</section>
