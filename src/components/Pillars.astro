---
import Reveal from "./Reveal.astro";

const pillars = [
  {
    years: "10",
    unit: "yrs",
    title: "Development",
    body: "Hands-on engineering across languages, platforms, and eras — from the metal up to the product surface.",
  },
  {
    years: "10",
    unit: "yrs",
    title: "Architecture",
    body: "Designing systems that survive scale, change, and time — enterprise, distributed, and everything between.",
  },
  {
    years: "10",
    unit: "yrs",
    title: "Leadership",
    body: "Building teams and operating rhythms that ship — coaching engineers, managing managers, aligning to outcomes.",
  },
  {
    years: "3",
    unit: "yrs",
    title: "AI",
    body: "Applied AI and agentic systems — moving from prototypes to production where it creates real leverage.",
  },
];
---

<section id="pillars" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
  <Reveal class="mb-10 flex items-end justify-between gap-6">
    <div>
      <div class="mb-3 text-xs uppercase tracking-[0.2em] text-muted">The arc</div>
      <h2 class="font-display text-4xl tracking-tight md:text-5xl">
        Four chapters. <span class="gradient-text">One throughline.</span>
      </h2>
    </div>
    <div class="hidden max-w-xs text-sm text-fg/60 md:block">
      Each chapter compounded the next. The craft informs the architecture;
      the architecture informs the leadership; all three now point at AI.
    </div>
  </Reveal>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      pillars.map((p, i) => (
        <Reveal delay={i * 80}>
          <article class="glass surface-hover group relative h-full overflow-hidden rounded-2xl p-6 transition hover:-translate-y-0.5">
            <div
              class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-60"
              style="background: radial-gradient(closest-side, var(--g2), transparent 70%);"
            />
            <div class="flex items-baseline gap-1">
              <span class="font-display text-6xl leading-none gradient-text">
                {p.years}
              </span>
              <span class="text-sm text-muted">{p.unit}</span>
            </div>
            <h3 class="mt-4 text-lg font-medium tracking-tight text-fg/95">
              {p.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-fg/65">{p.body}</p>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
