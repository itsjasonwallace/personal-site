---
import Reveal from "./Reveal.astro";
import { LINKEDIN_URL } from "../consts";
---

<Reveal>
  <div class="rounded-[6px] bg-ivory px-8 py-9 md:px-10 md:py-10">
    <div
      class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between md:gap-10"
    >
      <div class="max-w-xl">
        <div class="label">Let's talk</div>
        <h2
          class="mt-3 font-display tracking-tight text-ink"
          style="font-size: clamp(1.6rem, 2.4vw, 2rem); line-height: 1.15;"
        >
          If the role is real and the work is hard, let's compare notes.
        </h2>
      </div>
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener"
        class="btn-accent shrink-0 whitespace-nowrap"
      >
        Connect on LinkedIn <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Reveal>
