---
import Reveal from "./Reveal.astro";
---

<section id="about">
  <Reveal>
    <div class="label">About</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      One practice. <em class="italic text-accent">Two vantage points.</em>
    </h2>
  </Reveal>

  <Reveal delay={80}>
    <div
      class="mt-7 grid grid-cols-1 gap-x-10 gap-y-5 text-[15.5px] leading-relaxed text-ink-soft md:grid-cols-2"
    >
      <p>
        I'm an engineering leader who never stopped designing systems, and an
        architect who learned to run the room. I lead the way I architect —
        with bias for clarity, evidence, and pace — and I architect the way I
        lead, with the seams that survive what you didn't see coming.
      </p>
      <p>
        Currently leading teams in Wealth & Asset Management Engineering at Charles
        Schwab. Before that, Associate Director at Galliard Capital, co-founder
        and Director of Technology at Skyline, and Solution Architect at Wells
        Fargo. Twenty-four years across .NET, Java, TypeScript, cloud-native
        platforms, distributed data, and applied AI.
      </p>
    </div>
  </Reveal>
</section>
