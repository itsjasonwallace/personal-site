---
// Tri-state theme toggle. Click cycles: system → light → dark → system.
// The active icon is shown via CSS based on [data-pref] written by theme.ts.
---

<button
  type="button"
  data-theme-toggle
  data-pref="system"
  aria-label="Theme: system. Click to change."
  class="surface surface-hover relative inline-flex h-9 w-9 items-center justify-center rounded-full"
>
  <!-- System (monitor) -->
  <svg
    class="theme-ico theme-ico-system h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <!-- Light (sun) -->
  <svg
    class="theme-ico theme-ico-light h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- Dark (moon) -->
  <svg
    class="theme-ico theme-ico-dark h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style is:global>
  [data-theme-toggle] .theme-ico {
    position: absolute;
    opacity: 0;
    transform: scale(0.85) rotate(-20deg);
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-theme-toggle][data-pref="system"] .theme-ico-system,
  [data-theme-toggle][data-pref="light"] .theme-ico-light,
  [data-theme-toggle][data-pref="dark"] .theme-ico-dark {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>
