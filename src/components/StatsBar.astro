---
const stats = [
  { label: "Years building", value: "24" },
  { label: "Years leading", value: "12" },
  { label: "Platform AUM in production", value: "$600M+" },
];
---

<div class="card grid grid-cols-2 gap-y-6 px-6 py-6 sm:grid-cols-4 sm:gap-y-0">
  {
    stats.map((s) => (
      <div>
        <div class="label">{s.label}</div>
        <div class="mt-2 font-display text-[40px] leading-none text-ink">
          {s.value}
        </div>
      </div>
    ))
  }
</div>
