---
import { yearsBuilding } from "../data/career";

const stats = [
  { label: "Years building", value: String(yearsBuilding) },
  { label: "Years leading", value: "12" },
];
---

<div class="card grid w-fit grid-cols-2 gap-x-14 px-7 py-6 sm:gap-x-24">
  {
    stats.map((s) => (
      <div>
        <div class="label">{s.label}</div>
        <div class="mt-2 font-display text-[40px] leading-none text-ink">
          {s.value}
        </div>
      </div>
    ))
  }
</div>
