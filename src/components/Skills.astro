---
import Reveal from "./Reveal.astro";

const groups = [
  {
    label: "Leadership",
    items: [
      "Engineering strategy",
      "Org design & hiring",
      "Mentoring leaders",
      "Stakeholder alignment",
      "Budget & roadmap",
      "Vendor selection",
      "Communities of Practice",
    ],
  },
  {
    label: "Applied AI",
    items: [
      "GenAI developer tooling",
      "GitHub Copilot",
      "MCP servers (built & integrated)",
      "LLM-backed services",
      "Agentic workflows",
      "LangChain · AutoGen",
      "RAG · pgvector",
      "Azure OpenAI · Vertex AI · Claude",
      "Human-in-the-loop review",
      "AI governance & rollout",
    ],
  },
  {
    label: "Architecture",
    items: [
      "Distributed systems",
      "Microservices",
      "Microfrontends",
      "Event-driven systems",
      "API design · REST",
      "12-factor",
      "Resilience patterns",
      "OAuth2 / OIDC",
      "Domain-Driven Design",
      "Distributed data",
    ],
  },
  {
    label: "Cloud & Platforms",
    items: [
      "Azure",
      "GCP / BigQuery",
      "AWS",
      "Cloud Foundry / PCF",
      "Docker / Kubernetes",
      "Apigee · Azure APIM",
      "Cloud-native",
      "SaaS platforms",
    ],
  },
  {
    label: "Languages & Frameworks",
    items: [
      "C# / .NET",
      "Java",
      "TypeScript / JavaScript",
      "Python",
      "SQL",
      "Node.js",
      "Angular",
    ],
  },
  {
    label: "Data & Integration",
    items: [
      "SQL Server",
      "Postgres",
      "Oracle",
      "Cosmos DB",
      "Kafka",
      "RabbitMQ",
      "Pub/Sub · Service Bus",
    ],
  },
  {
    label: "Reliability",
    items: [
      "SLOs & SLAs",
      "SRE",
      "Incident response & RCA",
      "Observability · OpenTelemetry",
      "Splunk · AppDynamics",
      "Datadog · Grafana",
      "A/B testing",
    ],
  },
  {
    label: "Delivery",
    items: [
      "CI/CD",
      "GitHub",
      "DevSecOps",
      "Automated testing",
      "Quality gates",
      "Agile · TDD",
    ],
  },
];
---

<section id="toolkit">
  <Reveal>
    <div class="label">Toolkit</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      What I bring.
    </h2>
  </Reveal>

  <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      groups.map((g, i) => (
        <Reveal delay={i * 70}>
          <div class="card h-full p-6">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-muted">
              {g.label}
            </div>
            <ul role="list" class="mt-4 flex flex-wrap gap-1.5">
              {g.items.map((it) => (
                <li class="chip">{it}</li>
              ))}
            </ul>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
