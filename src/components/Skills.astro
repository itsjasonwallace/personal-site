---
import Reveal from "./Reveal.astro";

const groups = [
  {
    label: "Leadership",
    items: [
      "Engineering strategy",
      "Org design & hiring",
      "Mentoring leaders",
      "Stakeholder alignment",
      "Budget & roadmap",
      "Agile · CI/CD · TDD",
    ],
  },
  {
    label: "Architecture",
    items: [
      "Domain-Driven Design",
      "Microservices",
      "Event-driven systems",
      "Distributed data",
      "Cloud-native (Azure / GCP / CF)",
      "SaaS platforms",
    ],
  },
  {
    label: "Languages & Data",
    items: [
      ".NET",
      "Java",
      "TypeScript",
      "Node.js",
      "MS SQL Server",
      "Cosmos DB",
      "NoSQL",
      "Oracle",
    ],
  },
  {
    label: "Applied AI",
    items: [
      "Agentic systems",
      "Production AI tooling",
      "Evals & guardrails",
      "AI policy & rollout",
      "RAG",
      "LangChain"
    ],
  },
];
---

<section id="toolkit">
  <Reveal>
    <div class="label">Toolkit</div>
    <h2 class="section-title mt-3 font-display tracking-tight text-ink">
      What I bring.
    </h2>
  </Reveal>

  <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      groups.map((g, i) => (
        <Reveal delay={i * 70}>
          <div class="card h-full p-6">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-muted">
              {g.label}
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {g.items.map((it) => (
                <span class="chip">{it}</span>
              ))}
            </div>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
