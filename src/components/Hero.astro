---
import Reveal from "./Reveal.astro";
import StatsBar from "./StatsBar.astro";
import { SITE_DESCRIPTION } from "../consts";
import { careerStartYear } from "../data/career";

// Stands in for the sidebar meta block below lg, where that block is hidden so
// the headline reaches the first viewport. Hidden at lg, where the meta returns
// and would otherwise repeat these facts beside the hero.
const eyebrows = ["Denver, CO", "Charles Schwab", `Building since ${careerStartYear}`];
---

<section class="pt-2 md:pt-4">
  <Reveal onLoad class="lg:hidden">
    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.18em] text-accent"
    >
      {
        eyebrows.map((e, i) => (
          <>
            {i > 0 && <span class="text-muted">·</span>}
            <span>{e}</span>
          </>
        ))
      }
    </div>
  </Reveal>

  <Reveal onLoad>
    <h1
      class="mt-7 font-display tracking-tight text-ink lg:mt-0"
      style="font-size: clamp(2.5rem, 5.4vw, 4.5rem); line-height: 1.02;"
    >
      I lead engineering teams and <em class="italic text-accent"
        >design the systems</em
      > they build.
    </h1>
  </Reveal>

  <Reveal onLoad delay={80}>
    <p class="mt-7 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
      {SITE_DESCRIPTION}
    </p>
  </Reveal>

  <Reveal onLoad delay={160} class="mt-10">
    <StatsBar />
  </Reveal>
</section>
