---
import Reveal from "./Reveal.astro";
const linkedin = "https://www.linkedin.com/in/itsjasonwallace";
const monogram = "JW";
---

<section id="top" class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 md:pt-36 md:pb-44">
  <Reveal class="mb-8 flex items-center gap-4">
    <div class="relative">
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full text-lg font-medium tracking-wider text-white"
        style="background: conic-gradient(from 140deg, var(--g1), var(--g2), var(--g3), var(--g1));"
      >
        <span class="rounded-full bg-bg/85 px-3 py-2 backdrop-blur-sm">{monogram}</span>
      </div>
      <div
        class="absolute inset-0 -z-10 rounded-full blur-2xl"
        style="background: conic-gradient(from 140deg, var(--g1), var(--g2), var(--g3), var(--g1)); opacity: 0.5;"
      >
      </div>
    </div>
    <div class="text-sm text-muted">
      <div class="text-fg/80">Technology Leader</div>
      <div>Engineering · Architecture · Leadership · AI</div>
    </div>
  </Reveal>

  <Reveal delay={80}>
    <h1
      class="font-display tracking-tight"
      style="font-size: clamp(2.25rem, 7vw, 5.75rem); line-height: 1.05; padding-top: 0.08em;"
    >
      <span class="block text-fg/95">Jason Wallace.</span>
      <span class="block gradient-text">More than two decades of building.</span>
    </h1>
  </Reveal>

  <Reveal delay={160} class="mt-10 flex flex-wrap items-center gap-3">
    <a
      href={linkedin}
      target="_blank"
      rel="noopener"
      class="btn-primary group px-5 py-3 text-sm"
    >
      <span>Connect on LinkedIn</span>
      <span class="transition group-hover:translate-x-0.5">→</span>
    </a>
    <a
      href="#pillars"
      class="surface surface-hover inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm text-fg/85"
    >
      See the arc ↓
    </a>
  </Reveal>

  <div class="hairline mt-24"></div>
</section>
