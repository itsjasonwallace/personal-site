---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Reveal from "../components/Reveal.astro";
---

<Base
  title="Not found — Jason Wallace"
  description="The page you're looking for doesn't exist."
>
  <div class="lg:grid lg:grid-cols-[320px_minmax(0,1fr)]">
    <Sidebar />
    <main class="lg:col-start-2">
      <div
        class="mx-auto max-w-[820px] px-6 py-12 md:px-10 md:py-16 lg:px-16 lg:py-20"
      >
        <Reveal>
          <div class="label">Error · 404</div>
          <h1
            class="mt-4 font-display tracking-tight text-ink"
            style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.02;"
          >
            Lost the thread.
            <em class="italic text-accent">Let's get you back.</em>
          </h1>
        </Reveal>

        <Reveal delay={80}>
          <p class="mt-7 max-w-[58ch] text-[16px] leading-relaxed text-ink-soft">
            The link may be broken, or the page moved. Head home, or reach out
            on LinkedIn.
          </p>
        </Reveal>

        <Reveal delay={160} class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/" class="btn-ink">
            Back to home <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://www.linkedin.com/in/itsjasonwallace"
            target="_blank"
            rel="noopener"
            class="rule inline-flex items-center gap-2 rounded-[4px] px-4 py-2.5 text-sm text-ink"
          >
            Connect on LinkedIn
          </a>
        </Reveal>
      </div>
    </main>
  </div>
</Base>
