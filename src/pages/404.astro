---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Reveal from "../components/Reveal.astro";
---

<Base
  title="Not found — Jason Wallace"
  description="The page you're looking for doesn't exist."
>
  <Nav />
  <main>
    <section class="relative mx-auto max-w-6xl px-4 pt-24 pb-32 md:pt-36 md:pb-44">
      <Reveal class="mb-8 flex items-center gap-4">
        <div class="relative">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full text-lg font-medium tracking-wider text-white"
            style="background: conic-gradient(from 140deg, var(--g1), var(--g2), var(--g3), var(--g1));"
          >
            <span class="rounded-full bg-bg/85 px-3 py-2 backdrop-blur-sm">404</span>
          </div>
          <div
            class="absolute inset-0 -z-10 rounded-full blur-2xl"
            style="background: conic-gradient(from 140deg, var(--g1), var(--g2), var(--g3), var(--g1)); opacity: 0.5;"
          >
          </div>
        </div>
        <div class="text-sm text-muted">
          <div class="text-fg/80">Page not found</div>
          <div>The link may be broken, or the page moved.</div>
        </div>
      </Reveal>

      <Reveal delay={80}>
        <h1
          class="font-display tracking-tight"
          style="font-size: clamp(2.75rem, 7vw, 5.75rem); line-height: 1.05; padding-top: 0.08em;"
        >
          <span class="block text-fg/95">Lost the thread.</span>
          <span class="block gradient-text">Let's get you back.</span>
        </h1>
      </Reveal>

      <Reveal delay={160} class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/" class="btn-primary group px-5 py-3 text-sm">
          <span>Back to home</span>
          <span class="transition group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href="https://www.linkedin.com/in/itsjasonwallace"
          target="_blank"
          rel="noopener"
          class="surface surface-hover inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm text-fg/85"
        >
          Connect on LinkedIn
        </a>
      </Reveal>

      <div class="hairline mt-24"></div>
    </section>
  </main>
</Base>
