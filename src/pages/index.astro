---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import HowIWork from "../components/HowIWork.astro";
import Career from "../components/Career.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import {
  LINKEDIN_URL,
  SITE_NAME,
  SITE_TITLE,
  SEO_DESCRIPTION,
} from "../consts";

const site = Astro.site!.href;

// Emitted here rather than in the layout so the 404 page does not describe a
// Person whose canonical URL is /404.
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": site,
  url: site,
  name: SITE_TITLE,
  dateModified: new Date().toISOString(),
  mainEntity: {
    "@type": "Person",
    "@id": `${site}#person`,
    name: SITE_NAME,
    givenName: "Jason",
    familyName: "Wallace",
    jobTitle: "Senior Engineering Manager",
    description: SEO_DESCRIPTION,
    url: site,
    image: new URL("/portrait.webp", Astro.site).href,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Denver",
      addressRegion: "CO",
      addressCountry: "US",
    },
    worksFor: {
      "@type": "Organization",
      name: "Charles Schwab",
      url: "https://www.schwab.com/",
    },
    knowsAbout: [
      "Engineering leadership",
      "Domain-Driven Design",
      "Event-driven architecture",
      "Cloud-native platforms",
      "Applied AI",
    ],
    sameAs: [LINKEDIN_URL],
  },
};
---

<Base schema={schema}>
  <div class="lg:grid lg:grid-cols-[320px_minmax(0,1fr)]">
    <Sidebar />
    <main
      id="main"
      tabindex="-1"
      class="lg:col-start-2 focus-visible:outline-none"
    >
      <div
        class="mx-auto max-w-[820px] space-y-24 px-6 py-12 md:px-10 md:py-16 lg:px-16 lg:py-20"
      >
        <Hero />
        <About />
        <HowIWork />
        <Career />
        <Skills />
        <Contact />
      </div>
    </main>
  </div>
</Base>
